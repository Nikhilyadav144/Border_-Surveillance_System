// ============================================================
// ANALYTICS
// ============================================================

function Analytics({
  cameras,
}) {
  const totalPersons =
    cameras.reduce(
      (sum, camera) =>
        sum +
        Number(
          camera.stats?.persons ||
            0
        ),
      0
    );

  const totalVehicles =
    cameras.reduce(
      (sum, camera) =>
        sum +
        Number(
          camera.stats?.vehicles ||
            0
        ),
      0
    );

  const totalDetections =
    cameras.reduce(
      (sum, camera) =>
        sum +
        Number(
          camera.stats?.detections ||
            0
        ),
      0
    );

  const activeCameras =
    cameras.filter(
      (camera) =>
        camera.running
    ).length;

  return (
    <div className="page">

      <div className="page-intro">

        <div>

          <div className="section-label">
            OPERATIONAL ANALYTICS
          </div>

          <h2>
            Surveillance Analytics
          </h2>

          <p>
            Aggregated AI telemetry
            across the surveillance
            network.
          </p>

        </div>

      </div>

      <div className="analytics-cards">

        <AnalyticsCard
          title="PERSONS DETECTED"
          value={totalPersons}
        />

        <AnalyticsCard
          title="VEHICLES DETECTED"
          value={totalVehicles}
        />

        <AnalyticsCard
          title="TOTAL DETECTIONS"
          value={totalDetections}
        />

        <AnalyticsCard
          title="ACTIVE CAMERAS"
          value={activeCameras}
        />

      </div>

      <section className="panel">

        <div className="panel-header">

          <div>

            <div className="section-label">
              NETWORK PERFORMANCE
            </div>

            <h3>
              Camera Performance
            </h3>

          </div>

        </div>

        <div className="performance-list">

          {cameras.map(
            (camera) => (

              <div
                className="performance-row"
                key={camera.id}
              >

                <div className="performance-name">

                  <strong>
                    {camera.id}
                  </strong>

                  <span>
                    {camera.name}
                  </span>

                </div>

                <div className="performance-stat">

                  <span>
                    FPS
                  </span>

                  <strong>
                    {Number(
                      camera.stats?.fps ||
                        0
                    ).toFixed(1)}
                  </strong>

                </div>

                <div className="performance-stat">

                  <span>
                    INFERENCE
                  </span>

                  <strong>

                    {Number(
                      camera.stats
                        ?.inference_ms ||
                        0
                    ).toFixed(1)}

                    ms

                  </strong>

                </div>

                <div className="performance-stat">

                  <span>
                    DETECTIONS
                  </span>

                  <strong>
                    {Number(
                      camera.stats
                        ?.detections ||
                        0
                    )}
                  </strong>

                </div>

              </div>

            )
          )}

        </div>

      </section>

    </div>
  );
}


// ============================================================
// ANALYTICS CARD
// ============================================================

function AnalyticsCard({
  title,
  value,
}) {
  return (
    <div className="analytics-card">

      <span>
        {title}
      </span>

      <strong>
        {value}
      </strong>

      <small>
        REAL-TIME
      </small>

    </div>
  );
}


// ============================================================
// SETTINGS
// ============================================================

function Settings({
  cameras,
}) {

  // Engine status is derived from what the running cameras actually report.
  // With every camera stopped there is no live state to show, and these rows
  // say so instead of claiming ACTIVE.
  const live =
    cameras.filter(
      (camera) =>
        camera.stats?.status === "ONLINE"
    );

  const first = live[0];

  const engineStatus = {
    online: live.length > 0,
    tracking: live.length
      ? `ACTIVE (${live.length} camera${
          live.length === 1 ? "" : "s"
        })`
      : "IDLE - no camera running",
    anomaly:
      first?.stats?.anomaly ||
      "IDLE - no camera running",
    anpr:
      first?.stats?.anpr ||
      "IDLE - no camera running",
    lowLight:
      first?.stats?.night_context ||
      "IDLE - no camera running",
  };

  return (
    <div className="page">

      <div className="page-intro">

        <div>

          <div className="section-label">
            SYSTEM CONFIGURATION
          </div>

          <h2>
            System Settings
          </h2>

          <p>
            Current surveillance system
            configuration.
          </p>

        </div>

      </div>

      <div className="settings-grid">

        <section className="panel">

          <div className="panel-header">

            <div>

              <div className="section-label">
                AI ENGINE
              </div>

              <h3>
                Detection Configuration
              </h3>

            </div>

          </div>

          <SettingRow
            label="Object Detection"
            value="YOLO"
            active
          />

          {/* These read live backend state. A hard-coded "ACTIVE" would
              still say ACTIVE with every camera stopped. */}
          <SettingRow
            label="Tracking"
            value={engineStatus.tracking}
            active={engineStatus.online}
          />

          <SettingRow
            label="ANPR"
            value={engineStatus.anpr}
          />

          <SettingRow
            label="Anomaly Detection"
            value={engineStatus.anomaly}
            active={engineStatus.online}
          />

          <SettingRow
            label="Low-light Detection"
            value={engineStatus.lowLight}
            active={engineStatus.online}
          />

        </section>

        <section className="panel">

          <div className="panel-header">

            <div>

              <div className="section-label">
                NETWORK
              </div>

              <h3>
                Camera Network
              </h3>

            </div>

          </div>

          <SettingRow
            label="Configured Cameras"
            value={cameras.length}
            active
          />

          <SettingRow
            label="Active Cameras"
            value={
              cameras.filter(
                (camera) =>
                  camera.running
              ).length
            }
            active
          />

          <SettingRow
            label="API"
            value="FASTAPI"
            active
          />

          <SettingRow
            label="Frontend"
            value="REACT"
            active
          />

        </section>

      </div>

    </div>
  );
}


// ============================================================
// SETTING ROW
// ============================================================

function SettingRow({
  label,
  value,
  active,
}) {
  return (
    <div className="setting-row">

      <span>
        {label}
      </span>

      <strong
        className={
          active
            ? "setting-active"
            : ""
        }
      >
        {value}
      </strong>

    </div>
  );
}


// ============================================================
// SOURCE FORMATTER
// ============================================================

function formatSource(source) {
  if (!source) {
    return "Unknown";
  }

  if (typeof source === "string") {
    return source;
  }

  if (source.type === "video") {
    return source.path || "Video";
  }

  if (source.type === "webcam") {
    return `Webcam ${source.index ?? 0}`;
  }

  if (source.type === "rtsp") {
    return "RTSP Stream";
  }

  return source.type || "Unknown";
}


// ============================================================
// EXPORT
// ============================================================

export default App;