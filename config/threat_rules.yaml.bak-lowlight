# ==========================================================================
# Threat scoring rules
# --------------------------------------------------------------------------
# IMPORTANT: this is a CONFIGURABLE PROTOTYPE RISK MODEL.
#
# The numbers below are engineering defaults chosen to make the demo
# behave sensibly. They are NOT derived from any military, police or
# international security standard, and they have not been validated against
# real incident data. Treat the output as a ranked triage hint for a human
# operator, never as an authoritative threat assessment.
# ==========================================================================

# Every factor adds its weight to a 0-100 score. The score is clamped at 100.
# Set a weight to 0 to switch a factor off without deleting it.
factors:
  restricted_zone_intrusion:
    weight: 30
    label: "Restricted zone intrusion"

  border_zone_intrusion:
    weight: 25
    label: "Border zone entry"

  no_vehicle_zone_violation:
    weight: 20
    label: "Vehicle in a no-vehicle zone"

  line_crossing:
    weight: 20
    label: "Virtual boundary crossed"

  loitering:
    weight: 20
    label: "Loitering"

  # Extra points for every full minute of loitering beyond the threshold,
  # capped by loitering_duration_max.
  loitering_duration_per_minute: 5
  loitering_duration_max: 15

  behavioural_anomaly:
    weight: 15
    label: "Behavioural anomaly"

  unauthorised_vehicle:
    weight: 20
    label: "Unauthorised vehicle in a restricted area"

  watchlist_match:
    weight: 30
    label: "Watchlist match"

  night_time:
    weight: 10
    label: "Night-time activity"

  group_presence:
    weight: 10
    label: "Group of three or more people"
    # Number of tracked people in frame that counts as a group.
    min_group_size: 3

  high_speed:
    weight: 10
    label: "Unusually fast movement"
    # Speed in fraction-of-frame-diagonal per second.
    threshold: 0.35

# Score to level mapping. Ranges are inclusive of the lower bound.
levels:
  LOW:      0
  MEDIUM:   25
  HIGH:     50
  CRITICAL: 75

# Incident types that are always at least this level, whatever the score.
# Useful when an event must never be buried, e.g. a watchlist hit.
minimum_levels:
  watchlist_match: "HIGH"
  restricted_zone_intrusion: "MEDIUM"
